; Basic referral walk from a pinned root to an authoritative answer.
; Format follows Unbound's testbound replay syntax.

CONFIG_END
SCENARIO_BEGIN Basic referral

; Pinned root server.
RANGE_BEGIN 0 100
    ADDRESS 193.0.14.129
    ENTRY_BEGIN
        MATCH opcode subdomain
        ADJUST copy_id copy_query
        REPLY QR NOERROR
        SECTION QUESTION
        com. IN NS
        SECTION AUTHORITY
        com. IN NS ns.com.
        SECTION ADDITIONAL
        ns.com. IN A 192.5.6.30
    ENTRY_END
RANGE_END

; com. authoritative server.
RANGE_BEGIN 0 100
    ADDRESS 192.5.6.30
    ENTRY_BEGIN
        MATCH opcode subdomain
        ADJUST copy_id copy_query
        REPLY QR NOERROR
        SECTION QUESTION
        example.com. IN NS
        SECTION AUTHORITY
        example.com. IN NS ns.example.com.
        SECTION ADDITIONAL
        ns.example.com. IN A 192.0.2.53
    ENTRY_END
RANGE_END

; example.com. authoritative server.
RANGE_BEGIN 0 100
    ADDRESS 192.0.2.53
    ENTRY_BEGIN
        MATCH opcode qtype qname
        ADJUST copy_id copy_query
        REPLY QR AA NOERROR
        SECTION QUESTION
        www.example.com. IN A
        SECTION ANSWER
        www.example.com. 60 IN A 192.0.2.10
    ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
SECTION QUESTION
www.example.com. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR NOERROR
SECTION QUESTION
www.example.com. IN A
SECTION ANSWER
www.example.com. 60 IN A 192.0.2.10
ENTRY_END

SCENARIO_END
